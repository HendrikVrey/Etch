<Project>

  <PropertyGroup Label="Language">
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!--
      Warnings stay warnings, by choice (Hendrik, 2026-08-01). The earlier note here
      promised to flip this on "once M0 compiles" and that promise is withdrawn rather
      than left to rot: a solo desktop project does not benefit from a build that refuses
      to run because a perf suggestion fired.

      What replaces it is the discipline the flag was standing in for. The solution was
      taken to zero warnings on 2026-08-01, and every rule switched off since is switched
      off *at its site* with a written reason — [SuppressMessage] on the member for the
      three in src/, and tests/.editorconfig for the two that only apply to test code.
      There is no blanket NoWarn anywhere, so a warning appearing in a build is news.
    -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Label="Identity">
    <Product>Etch</Product>
    <Company>Hendrik Vrey</Company>
    <Authors>Hendrik Vrey</Authors>
    <Copyright>Copyright (c) 2026 Hendrik Vrey</Copyright>
    <VersionPrefix>1.0.1</VersionPrefix>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

  <PropertyGroup Label="Packaging">
    <!--
      Nothing in this repository is a library for anyone else except Etch.Core, which
      turns this back on for itself. Off by default so that `dotnet pack Etch.slnx`
      produces exactly one package instead of also trying to pack a WPF application
      and three test projects.
    -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup Label="Runtime">
    <!--
      Globalization-invariant mode must stay OFF. It silently breaks culture
      lookups at runtime and is a known source of very confusing crashes.
    -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- Workstation GC: lower memory and better startup for a desktop app. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <!-- Tiered JIT with quick startup tier is the right default for cold start. -->
    <TieredCompilation>true</TieredCompilation>
    <TieredCompilationQuickJit>true</TieredCompilationQuickJit>
    <TieredCompilationQuickJitForLoops>true</TieredCompilationQuickJitForLoops>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <PropertyGroup Label="Repro">
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

</Project>
