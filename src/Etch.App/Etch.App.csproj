<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Etch.App</RootNamespace>
    <AssemblyName>Etch</AssemblyName>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!--
      The icon is embedded in the executable as a Win32 resource, and that is the only
      copy of it in the shipped product. A WPF Window with no Icon set falls back to the
      executable's icon, so this one property covers the taskbar, Alt+Tab, the window,
      and Explorer without loading an image resource during startup.

      Deliberately NOT set on ui:TitleBar: the title bar holds the tab strip and nothing
      else (see MainWindow.xaml), and an icon there would take width from the tabs.

      assets/ is the single source of truth: see assets/build-icon.py. Keeping one copy
      rather than a build-input duplicate inside the project is what stops the shipped
      .ico from drifting away from the SVG it was drawn from.
    -->
    <ApplicationIcon>..\..\assets\etch.ico</ApplicationIcon>
    <DebugType>embedded</DebugType>
    <!-- Required by the [LibraryImport] source generator (ConsoleBridge). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!--
      Etch owns its own entry point (see Program.cs) so the startup timeline can
      take its first measurement BEFORE the Application object and its XAML
      resource dictionaries are constructed. That split is the entire point of the
      M0 spike: it separates host/runtime init cost from WPF-UI theme cost.

      Clearing EnableDefaultApplicationDefinition is the whole mechanism. With no
      ApplicationDefinition, the SDK generates no Main of its own (so ours does not
      collide), and the default Page glob (which excludes @(ApplicationDefinition),
      now empty) picks App.xaml up automatically and still emits
      InitializeComponent. Adding an explicit <Page Include="App.xaml" /> here would
      make it a duplicate item and fail the build with NETSDK1022.
    -->
    <StartupObject>Etch.App.Program</StartupObject>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Belt and braces, and harmless either way: the SDK de-duplicates <Using> items, so
      this produces exactly one `global using System.IO;` whether or not the SDK already
      supplied one.

      The original justification here was wrong and is worth correcting rather than
      deleting. It claimed UseWPF drops System.IO because System.Windows.Shapes.Path
      collides with System.IO.Path. Comparing the generated GlobalUsings files shows the
      namespace UseWPF actually drops is System.Net.Http: System.IO is present in both.
      To check whether this line is still doing anything, comment it out and diff
      obj\Debug\net10.0-windows\Etch.App.GlobalUsings.g.cs.
    -->
    <Using Include="System.IO" />

    <!--
      The command line is Etch's untrusted-input boundary, and it is internal.
      Testing it matters more than keeping the assembly sealed.
    -->
    <InternalsVisibleTo Include="Etch.App.Tests" />
  </ItemGroup>

  <PropertyGroup Label="Publish">
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!--
      Single-file compression trades startup time for file size: it decompresses
      on every launch. Etch sells startup time, so this stays off permanently.
    -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <!--
      WPF is not trim-friendly: XAML resolves types by reflection, so trimming
      breaks it in ways that only show up at runtime. R2R is where the startup win
      is. NativeAOT is not available for WPF at all.
    -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" />
    <PackageReference Include="AvalonEdit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Etch.Core\Etch.Core.csproj" />
    <ProjectReference Include="..\Etch.Persistence\Etch.Persistence.csproj" />
  </ItemGroup>

</Project>
