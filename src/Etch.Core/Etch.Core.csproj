<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Etch.Core is pure functions over text: no UI reference, no I/O, no platform
    dependency. Everything of value in the product lives here so it can be
    exhaustively unit-tested without a GUI. Keep it that way, if a PackageReference
    or a `using System.Windows` appears in this project, something has gone wrong.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Etch.Core</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <!--
      Embedded, not portable: the package carries its own debug information so a
      consumer can step into a transform without a symbol server. It costs a little
      size in a library that has no other dependencies, and it removes the .snupkg
      question entirely: GitHub Packages does not host symbol packages.
    -->
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <!--
    This is the only packable project in the solution (Directory.Build.props turns
    packing off by default). It is packed so that Sling, the HTTP client that runs
    this same transform chain over a response body, can consume the engine as a
    versioned dependency rather than as a submodule or a copied folder.

    THE FEED IS PRIVATE, AND THE LICENCE IS WHY. LICENCE §3(b) forbids making the
    Software or any part of it available to a third party, and a package on
    nuget.org is precisely that: every consumer's build output embeds
    Etch.Core.dll, so shipping their application redistributes it. Publishing a
    package nobody is licensed to use would be a broken thing to publish. The
    package therefore goes to a private feed under the copyright holder's own
    account, where the question does not arise. See docs/packaging.md.
  -->
  <PropertyGroup Label="Packaging">
    <IsPackable>true</IsPackable>
    <PackageId>Etch.Core</PackageId>
    <Title>Etch.Core</Title>
    <Description>The Etch transform engine: format detection, the transform catalogue, palette ranking, and the text utilities behind them. Pure, no UI, no I/O, no dependencies. Source-available, not open source; see the bundled LICENSE.</Description>
    <PackageTags>etch;text;transform;json;base64;jwt;formatting</PackageTags>
    <PackageProjectUrl>https://github.com/HendrikVrey/Etch</PackageProjectUrl>
    <RepositoryUrl>https://github.com/HendrikVrey/Etch</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!--
      Deliberately NOT <PackageLicenseExpression>. That property takes an SPDX
      identifier, and naming an SPDX licence for terms that are not one would
      misstate them to every tool that reads package metadata.
    -->
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <!--
      The package version tracks the repository's VersionPrefix rather than carrying
      one of its own. One number to bump, and with a single consumer the cost, a
      version bump on a release that did not change this assembly's API, buys
      nothing worth a second version scheme.
    -->
  </PropertyGroup>

  <ItemGroup Label="Packaging">
    <None Include="$(MSBuildThisFileDirectory)..\..\LICENSE" Pack="true" PackagePath="" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="" Visible="true" />
  </ItemGroup>

</Project>
