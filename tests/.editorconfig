# Rules relaxed for test code only.
#
# This file exists so the relaxations are scoped, visible, and each one has a reason
# written next to it. Nothing here applies to src/ — a rule that is wrong for a test is
# usually still right for the thing being tested. Anything switched off below should be
# switched back on if its reason stops being true.

[*.cs]

# CA1707 — Identifiers should not contain underscores.
#
# 373 hits, all of them test method names, and the convention is deliberate:
# Every_recognised_format_has_a_label_of_its_own reads as a sentence in a test runner's
# output, which is the one place these names are ever read. The rule is aimed at public
# API surface that callers have to type; a test method has no callers. Renaming 373
# methods to PascalCase would make the failure output harder to read in exchange for
# nothing at all.
dotnet_diagnostic.CA1707.severity = none

# xUnit1051 was switched off here between 2026-08-01 and 2026-08-06 and is now back on at
# its default severity, so there is no entry for it.
#
# The deferral said to turn it back on once the suite was green and then work through the
# call sites in one pass, which is what happened: 185 of them now pass
# TestContext.Current.CancellationToken. Two sites deliberately pass a different token —
# AtomicFileTests and JournalWriterTests each have one that hands in an already-cancelled
# source, because cancellation is the behaviour under test — and the rule is satisfied by
# those too, since what it asks for is a token rather than that particular token.
#
# Left as a note rather than deleted: the next person to find a test hanging in CI should
# know that the runner *can* cancel these, so a hang is a deadlock in the code under test
# and not a missing token.
