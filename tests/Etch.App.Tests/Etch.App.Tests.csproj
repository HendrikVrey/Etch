<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Must match Etch.App's TFM to reference it. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- xunit.v3 test projects are self-executing. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- See the note in Etch.App.csproj: de-duplicated by the SDK, harmless either way. -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Etch.App\Etch.App.csproj" />
    <!--
      Referenced directly as well as transitively. The workspace tests assert against
      EtchPaths and BufferId, and a project that names a type should say where it comes
      from rather than inherit it by accident.
    -->
    <ProjectReference Include="..\..\src\Etch.Persistence\Etch.Persistence.csproj" />
    <!--
      And Etch.Core, for the same reason: the large-document tests name
      DocumentSizePolicy and DocumentTier.
    -->
    <ProjectReference Include="..\..\src\Etch.Core\Etch.Core.csproj" />
  </ItemGroup>

</Project>
